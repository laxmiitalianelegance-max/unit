{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unit",
  "main": "src/unit369.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],

  // Production secrets and variables are managed in Cloudflare and must survive deploys.
  "keep_vars": true,

  "ai": {
    "binding": "AI",
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },

  "services": [
    {
      "binding": "SELF",
      "service": "unit",
    },
  ],

  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1,
    },
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "TOOL_STORE",
        "class_name": "ToolStore",
      },
      {
        "name": "NATIVE_STORE",
        "class_name": "NativeStore",
      },
      {
        "name": "UNIT369_SANDBOX",
        "class_name": "Sandbox",
      },
    ],
  },

  "migrations": [
    {
      "tag": "orchestrator-v2",
      "new_sqlite_classes": ["ToolStore"],
    },
    {
      "tag": "native-core-v1",
      "new_sqlite_classes": ["NativeStore"],
    },
    {
      "tag": "sandbox-execution-v1",
      "new_sqlite_classes": ["Sandbox"],
    },
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
